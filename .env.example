# === OpenAI ===
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# === Supabase ===
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Stripe (3 forfaits CAD / mois) ===
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ESSENTIEL=price_...   # 149 $/mois — 100 conversations
STRIPE_PRICE_CROISSANCE=price_...  # 299 $/mois — 300 conversations
STRIPE_PRICE_PRO=price_...         # 499 $/mois — 1 000 conversations

# === Twilio ===
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_DEFAULT_AREA_CODE=418
TWILIO_AUTO_PROVISION=true
# TWILIO_PROVISION_WITHOUT_BILLING=true   # dev local seulement
# TWILIO_SKIP_SIGNATURE=true              # dev local seulement
# TWILIO_RELEASE_ON_CANCEL=false          # par défaut on libère le numéro à l'annulation

# === Courriels (Resend) ===
RESEND_API_KEY=re_...
EMAIL_FROM=NoviaAI <notifications@noviaai.ca>
ADMIN_EMAIL=noviaai.contact@gmail.com
# SIGNUP_AUTO_CONFIRM=true                # dev seulement — pas de courriel de confirmation

# === Site ===
PEXELS_API_KEY=
PUBLIC_BASE_URL=https://noviaai.ca

# === Calendrier (OAuth Google + Microsoft) ===
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Optionnel — sinon dérivé de SUPABASE_SERVICE_ROLE_KEY
# CALENDAR_TOKEN_ENCRYPTION_KEY=
# Redirection OAuth (doit matcher la console Google / Azure)
# GOOGLE_CALENDAR_REDIRECT_URI=https://noviaai.ca/.netlify/functions/api-calendar-oauth-callback
# MICROSOFT_CALENDAR_REDIRECT_URI=https://noviaai.ca/.netlify/functions/api-calendar-oauth-callback

# === Admin ===
ADMIN_SECRET=changez-moi

